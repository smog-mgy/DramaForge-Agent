# ============================================================
# 复制本文件为 .env 并填入你的密钥
# ！！！绝不要把 .env 提交到 Git / GitHub ！！！
# ============================================================

# ---------- LLM（DeepSeek） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.8

# ---------- 本地向量化（RAG 用，可选） ----------
# 本地模型：无需 API Key，需要安装 sentence-transformers + torch
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 若想用云端 Embedding API（如硅基流动 SiliconFlow / 通义 DashScope），
# 填入 base_url / api_key / model 即可覆盖本地模式；留空则用本地模型。
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# ---------- 存储路径 ----------
# 向量库目录（默认项目下 .chroma_db）
CHROMA_DB_DIR=.chroma_db
# 产物输出目录（剧本/音频/视频）
OUTPUT_DIR=output

# ---------- 视频渲染（图文成片，可选） ----------
# 本地 ComfyUI 地址（需自行运行 ComfyUI）
COMFYUI_URL=http://127.0.0.1:8188
# ComfyUI 导出的 API 工作流 JSON 路径
COMFYUI_WORKFLOW=workflow_api.json
# 是否启用 ComfyUI 生成画面（False = 始终用文字画面兜底，无需显卡）
RENDER_USE_COMFYUI=true
# 视频分辨率和帧率
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
